# OrchestrAI backend secrets and runtime configuration.
# Copy this file to backend/.env and fill only the providers you use.
# Never commit backend/.env.

# Core LLM providers
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=

# Web search providers
WEB_SEARCH_PROVIDER=tavily
WEB_READ_PROVIDER=auto
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=
BROWSERLESS_API_KEY=

# Optional platform integrations
GITHUB_TOKEN=
FIGMA_ACCESS_TOKEN=

# Runtime / infrastructure
CORS_ORIGINS=http://localhost:3000
MAX_PLAYWRIGHT_BROWSERS=3
DATABASE_URL=postgresql+asyncpg://orchestrai:orchestrai@localhost:5432/orchestrai
REDIS_URL=
