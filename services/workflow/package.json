{
  "name": "@orchestrai/workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/api.mjs",
    "worker": "node src/worker.mjs",
    "migrate": "node src/migrate.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "node --check src/api.mjs && node --check src/worker.mjs && node --check src/store.mjs && node --check src/runtime.mjs"
  },
  "dependencies": {
    "@langchain/core": "1.2.8",
    "@langchain/langgraph": "1.4.8",
    "@langchain/langgraph-checkpoint-postgres": "1.0.4",
    "bullmq": "5.81.5",
    "jose": "6.1.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "knip": "6.41.0"
  }
}
