# R2: compose.yml. R3 candidate: compose.yml + compose.product.yml.
# R3 is currently a local candidate; the automatic production manifest remains R2.
# For a NEW installation, copy to deploy/private/production.env (Git ignored).
# Server file: /opt/orchestrai/secrets/production.env.
# For an EXISTING installation, preserve all current secrets; do not replace the
# environment file with this blank template or rotate database passwords here.

# Required infrastructure secrets. Generate a different 64-character hexadecimal
# value for each field on a new installation. These are NOT provider API keys.
# Hexadecimal avoids URL-escaping issues in the Compose connection strings.
# Do not reuse R1 or another project's credentials. DELEGATION_SECRET >= 32 bytes.
POSTGRES_PASSWORD=
WORKFLOW_DB_PASSWORD=
REDIS_PASSWORD=
DELEGATION_SECRET=

# Local build image names. Production release tooling overrides all three with
# the tested immutable GHCR image@sha256 references from the release manifest.
# Do not substitute latest tags for production release digests.
WORKFLOW_IMAGE=orchestrai/workflow:local
POSTGRES_IMAGE=orchestrai/postgres:local
REDIS_IMAGE=orchestrai/redis:local

# Confirmed total provider budget in CNY. Product gateway enforces atomic daily
# and monthly reservations; unknown failures retain their reservation. Settlement
# uses returned tokens and conservative price/FX ceilings, not provider invoices.
MODEL_DAILY_LIMIT_CNY=5
MODEL_MONTHLY_LIMIT_CNY=100

# Product infrastructure secrets: independently generated hex, preserve on upgrades.
MONGO_ADMIN_PASSWORD=
MONGO_CHAT_PASSWORD=
INGESTION_DB_PASSWORD=
INGESTION_MIGRATION_PASSWORD=
CHAT_JWT_SECRET=
CHAT_REFRESH_SECRET=
RAG_JWT_SECRET=
GATEWAY_KEY=
CHAT_CREDS_KEY=
CHAT_CREDS_IV=

# Provider keys stay server-side. configure-product.py reads filled providers.json
# and the existing private model env, without printing or changing those inputs.
DEEPSEEK_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

CHAT_IMAGE=orchestrai/chat:local
INGESTION_IMAGE=orchestrai/ingestion:local
GATEWAY_IMAGE=orchestrai/gateway:local
WEB_IMAGE=orchestrai/web:local
PRODUCT_URL=http://localhost:3088
PRODUCT_PORT=3088
ALLOW_REGISTRATION=false

# R3 provider input is stored separately in deploy/private/providers.json.
# See deploy/providers.example.json. Keep filled private files unchanged.
# Do not put provider keys in browser-visible NEXT_PUBLIC_* variables.
