+.orchestra-app, .orchestra-auth { color: rgb(var(--text-primary)); background: rgb(var(--surface-chat)); font-family: 'Inter', 'Microsoft YaHei', 'Noto Sans SC', sans-serif; }
+.orchestra-app [hidden] { display: none !important; }
+.orchestra-app :where(button, a, input, textarea):focus-visible, .orchestra-auth :where(button, a, input):focus-visible { outline: 2px solid rgb(var(--accent-primary)); outline-offset: 3px; }
+.orchestra-brand { display: inline-flex; align-items: center; gap: 12px; color: rgb(var(--text-primary)); font-size: 20px; font-weight: 650; letter-spacing: -.5px; }
+.orchestra-brand-mark { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 10px; background: rgb(var(--surface-active)); color: rgb(var(--accent-primary)); }
+.orchestra-brand-mark svg { transform: rotate(90deg); }
+:is(.orchestra-app, .orchestra-auth) .orchestra-primary, :is(.orchestra-app, .orchestra-auth) .orchestra-secondary { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 42px; padding: 10px 20px; border-radius: 11px; font-size: 13px; font-weight: 500; }
+:is(.orchestra-app, .orchestra-auth) .orchestra-primary { background: rgb(var(--surface-submit)); border: 1px solid rgb(var(--surface-submit)); color: #fff; }
+:is(.orchestra-app, .orchestra-auth) .orchestra-primary:hover { background: rgb(var(--surface-submit-hover)); }
+:is(.orchestra-app, .orchestra-auth) .orchestra-secondary { border: 1px solid rgb(var(--border-light)); background: rgb(var(--surface-primary)); color: rgb(var(--text-primary)); }
+:is(.orchestra-app, .orchestra-auth) .orchestra-secondary:hover { background: rgb(var(--surface-hover)); }
+:is(.orchestra-app, .orchestra-auth) .orchestra-primary:disabled, :is(.orchestra-app, .orchestra-auth) .orchestra-secondary:disabled { opacity: .5; cursor: not-allowed; }
+.orchestra-icon-button { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 32px; height: 32px; border-radius: 8px; color: rgb(var(--text-tertiary)); }
+.orchestra-icon-button:hover { color: rgb(var(--text-primary)); background: rgb(var(--surface-hover)); }
+.orchestra-sidebar-column { width: 224px; flex-shrink: 0; }
+.orchestra-sidebar { display: flex; flex-direction: column; width: 100%; height: 100%; padding: 24px 18px 16px; border-right: 1px solid rgb(var(--border-light)); background: rgb(var(--surface-primary-alt)); }
+.orchestra-sidebar-brand { display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px; }
+.orchestra-new-task { width: 100%; }
