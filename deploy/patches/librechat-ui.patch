+                  modalContent={config.interface.termsOfService.modalContent}
+                />
+              )}
+            </AssistantsMapContext.Provider>
+          </FileMapContext.Provider>
+        </SetConvoProvider>
+      </CodeHighlightThrottleContext.Provider>
+    </WorkbenchProvider>
   );
 }
