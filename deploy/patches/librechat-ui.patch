@@ -0,0 +1,78 @@
+import { useState } from 'react';
+import { useParams } from 'react-router-dom';
+import { Button } from '@librechat/client';
+import { ReactFlow, Background, Controls, MarkerType } from '@xyflow/react';
+import { useFileMapContext } from '~/Providers';
+import { useLocalize } from '~/hooks';
+import '@xyflow/react/dist/style.css';
+
+const nodes = [
+  { id: 'query', position: { x: 30, y: 20 }, data: { label: 'Research' } },
+  { id: 'review', position: { x: 30, y: 140 }, data: { label: 'Approval' } },
+  { id: 'result', position: { x: 30, y: 260 }, data: { label: 'Artifact' } },
+];
+const edges = [
+  { id: 'qr', source: 'query', target: 'review', markerEnd: { type: MarkerType.ArrowClosed } },
+  { id: 'ra', source: 'review', target: 'result', markerEnd: { type: MarkerType.ArrowClosed } },
+];
+
+/** Uses upstream identity-scoped files and route state; owns no parallel chat store. */
+export default function Context() {
+  const localize = useLocalize();
+  const { conversationId } = useParams();
+  const files = useFileMapContext();
+  const [canvas, setCanvas] = useState(false);
+  return (
+    <aside
+      className="hidden h-full w-80 shrink-0 flex-col border-l border-border-light bg-surface-secondary p-5 xl:flex"
+      aria-label={localize('com_orchestra_context')}
+    >
+      <div className="mb-5 flex items-center justify-between">
+        <h2 className="font-semibold text-text-primary">{localize('com_orchestra_context')}</h2>
+        <span className="rounded-full bg-surface-active px-2 py-1 text-xs text-accent-primary">
+          {localize('com_orchestra_badge')}
+        </span>
+      </div>
+      <p className="mb-5 text-sm text-text-secondary">{localize('com_orchestra_hint')}</p>
+      <details className="rounded-xl border border-border-light bg-surface-primary p-4" open>
+        <summary className="cursor-pointer font-medium">
+          {localize('com_orchestra_session')}
+        </summary>
+        <p className="mt-3 break-all text-xs text-text-tertiary">{conversationId}</p>
+      </details>
+      <details className="mt-3 rounded-xl border border-border-light bg-surface-primary p-4" open>
+        <summary className="cursor-pointer font-medium">{localize('com_orchestra_files')}</summary>
+        <ul className="mt-3 space-y-2 text-sm text-text-secondary">
+          {Object.values(files ?? {}).map((file) => (
+            <li key={file.file_id} className="break-all">
+              {file.filename}
+            </li>
+          ))}
+        </ul>
+        {Object.keys(files ?? {}).length === 0 && (
+          <p className="mt-3 text-sm text-text-tertiary">{localize('com_orchestra_empty')}</p>
+        )}
+      </details>
+      <Button
+        className="mt-4"
+        variant="outline"
+        onClick={() => setCanvas(!canvas)}
+        aria-expanded={canvas}
+      >
+        {localize('com_orchestra_canvas')}
+      </Button>
+      {canvas && (
+        <div
+          className="mt-3 min-h-80 flex-1 rounded-xl border border-border-light bg-surface-primary"
+          aria-label={localize('com_orchestra_canvas')}
+        >
+          <ReactFlow nodes={nodes} edges={edges} fitView nodesDraggable nodesConnectable={false}>
+            <Background />
+            <Controls showInteractive={false} />
+          </ReactFlow>
+        </div>
+      )}
+      <p className="mt-4 text-xs text-text-tertiary">{localize('com_orchestra_canvas_hint')}</p>
+    </aside>
+  );
+}
--- /dev/null
+++ b/client/src/components/Orchestra/Sidebar.tsx
@@ -0,0 +1,65 @@
+import { useMediaQuery } from '@librechat/client';
+import { UnifiedSidebar } from '~/components/UnifiedSidebar';
+import { SidebarChatProvider } from '~/components/UnifiedSidebar/UnifiedSidebar';
+import ConversationsSection from '~/components/UnifiedSidebar/ConversationsSection';
+import useNewChat from '~/hooks/Chat/useNewChat';
+import { useAuthContext, useLocalize } from '~/hooks';
+
+function Desktop() {
+  const localize = useLocalize();
+  const { user, logout } = useAuthContext();
+  const { handleNewChatClick } = useNewChat();
+  return (
+    <nav
+      className="flex h-full w-64 shrink-0 flex-col border-r border-border-light bg-surface-secondary"
+      aria-label="OrchestrAI"
+    >
+      <a
+        href="/orchestra"
+        className="flex items-center gap-3 px-5 py-7 text-xl font-semibold tracking-tight"
+      >
+        <span
+          className="flex h-9 w-9 items-center justify-center rounded-xl bg-surface-submit text-white"
+          aria-hidden="true"
+        >
+          O
+        </span>
+        {localize('com_orchestra_brand')}
+      </a>
+      <a
+        href="/c/new"
+        onClick={handleNewChatClick}
+        className="mx-4 rounded-xl border border-border-medium bg-surface-primary px-4 py-3 text-sm font-medium hover:bg-surface-hover"
+        aria-label={localize('com_ui_new_chat')}
+      >
+        + {localize('com_ui_new_chat')}
+      </a>
+      <div className="mx-4 mb-5 mt-4 rounded-xl bg-surface-active px-4 py-3 text-sm font-semibold text-accent-primary">
+        {localize('com_orchestra_title')}
+      </div>
+      <div className="min-h-0 flex-1">
+        <ConversationsSection />
+      </div>
+      <div className="m-4 rounded-xl border border-border-light bg-surface-primary p-4">
+        <p className="text-sm font-medium">{user?.name}</p>
+        <button
+          className="mt-2 text-xs text-text-tertiary hover:text-text-primary"
+          onClick={() => logout('/login')}
+        >
+          {localize('com_nav_log_out')}
+        </button>
+      </div>
+    </nav>
+  );
+}
+
+export default function Sidebar({ isSliding }: { isSliding: boolean }) {
+  const mobile = useMediaQuery('(max-width: 768px)');
+  // Keep upstream tested focus/swipe behavior on mobile during the R1 comparison.
+  if (mobile) return <UnifiedSidebar isSliding={isSliding} />;
+  return (
+    <SidebarChatProvider>
+      <Desktop />
+    </SidebarChatProvider>
+  );
+}
